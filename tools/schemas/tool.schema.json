{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acgs.ai/schemas/tool.schema.json",
  "title": "ACGS-Lite Tool Registry",
  "description": "Schema for tools/registry.yaml — the machine-readable catalog of executable surfaces.",
  "type": "object",
  "required": ["version", "tools"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "purpose", "command", "validation", "owner_module"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "env": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "failure_modes": { "type": "array", "items": { "type": "string" } },
        "retry": { "type": "string" },
        "validation": { "type": "string", "minLength": 1 },
        "owner_module": { "type": "string", "minLength": 1 }
      }
    }
  }
}
